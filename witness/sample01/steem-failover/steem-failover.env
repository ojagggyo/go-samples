# ========================================
# Steem Witness Failover Controller
# ========================================

# Witness account
STEEM_WITNESS=yasu.witness

# Active private key
STEEM_ACTIVE_PRIVATE_KEY=${ACTIVE_KEY_WITNESS}


# ========================================
# RPC endpoints
# 最大3つまで設定可能
# ========================================
STEEM_RPC_URL_1=https://api.steememory.com
STEEM_RPC_URL_2=https://api.steemit.com
STEEM_RPC_URL_3=

# ========================================
# Signing key failover chain
#
# _1 → _2 → _3 → _4
#
# 最後のキーは FAILSAFE として扱われ、
# 到達すると監視を停止します。
# ========================================

STEEM_SIGNING_KEY_1=STM5DnNw8LWg6Q5TS4wivQ5pR5iufTQYPBjw4vYEWQG8Yof4aZAhJ
STEEM_SIGNING_KEY_2=STM7gkLyT7mkXGj1NVDgLRdrpr5UeMCviv4rkPH9gXiQ8KsYjuhaU
STEEM_SIGNING_KEY_3=STM1111111111111111111111111111111114T1Anm

# ========================================
# Monitoring settings
# ========================================

# 監視間隔（秒）
POLL_SECONDS=60

# 状態保存ファイル
STATE_FILE=state.json

# signing key変更確認のタイムアウト（秒）
VERIFY_TIMEOUT_SECONDS=60

DRY_RUN=false