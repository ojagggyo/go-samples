# steememory.com の HTTPS server ブロック内へ組み込む設定例。
# 既存の /photos/ 設定と置き換える。proxy_pass の接続先は実環境に合わせる。
location = /photos {
    return 301 /photos/$is_args$args;
}

location ^~ /photos/ {
    auth_basic "Photos";
    auth_basic_user_file /etc/nginx/photos.htpasswd;
    satisfy all;

    # 末尾の / が /photos/ を取り除く。同一ホストで動く場合の接続先例。
    proxy_pass http://127.0.0.1:8080/;
    proxy_set_header Host $http_host;
    # クライアントが指定した値を必ず認証済みユーザー名で上書きする。
    proxy_set_header X-Photo-User $remote_user;
    proxy_set_header Authorization "";
    proxy_cache off;
}
